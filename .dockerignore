# Never bake secrets or local dev state into an image.
.env
.env.*
!.env.example

# VCS
.git
.gitignore

# Python
.venv
ekip/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Frontend (has its own Dockerfile/.dockerignore under frontend/)
frontend/node_modules
frontend/dist
frontend/e2e-report
frontend/test-results
frontend/playwright-report

# Docs/scratch -- not needed at runtime. README.md is the one exception:
# pyproject.toml's `readme = "README.md"` makes the image build fail without it.
*.md
!README.md
docs/
tests/
.github/

# scripts/ is mostly local eval/live-test/onboarding tooling with no runtime
# role. The process entrypoints the image runs, plus the build-time model
# bake, are the exception (see Dockerfile's COPY) -- `scripts/*` excludes the
# directory's contents, then the negations re-admit only those files.
scripts/*
!scripts/run_api_server.py
!scripts/run_ingestion_worker.py
!scripts/run_mcp_server.py
!scripts/bake_models.py
