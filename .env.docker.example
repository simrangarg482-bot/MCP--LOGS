# Local, production-shaped docker-compose stack config (Phase 3).
#
# Deliberately SEPARATE from the project's own root `.env` (used for
# non-Docker local dev against the real remote Neon/Redis Cloud/OpenAI
# instances): this file drives the fully local postgres/redis containers
# docker-compose.yml defines, and must never be confused with -- or
# accidentally loaded in place of -- the real one.
#
# Copy this file to `.env.docker` (git-ignored) and fill in a real
# OPENAI_API_KEY to exercise AI features against the compose stack. Every
# other value below is a safe, non-secret, local-only default -- these
# containers are not reachable outside your own machine.

# Runtime credential -- what backend/worker actually connect as (the
# `migrate` service in docker-compose.yml overrides this one value to the
# local Postgres superuser instead, since it needs admin privileges to run
# migrations at all; see docs/operations/deployment.md's "Migration
# database vs runtime database"). `ekip_app` doesn't exist in a brand-new
# postgres container yet -- migration b8f3d6a1c4e7 creates it (using
# EKIP_APP_ROLE_PASSWORD below) the first time `docker compose up` runs
# `migrate`, before backend/worker ever start (docker-compose.yml's
# `depends_on: migrate: condition: service_completed_successfully`).
DATABASE_URL=postgresql+asyncpg://ekip_app:ekip_app_local_dev_only@postgres:5432/ekip
REDIS_URL=redis://redis:6379/0

# Read by migration b8f3d6a1c4e7 when `migrate` runs -- must match the
# password embedded in DATABASE_URL above, or backend/worker simply fail to
# authenticate once migrate has (re)created the role with this value.
EKIP_APP_ROLE_PASSWORD=ekip_app_local_dev_only

ENVIRONMENT=development
LOG_LEVEL=INFO

# Local-only placeholder secrets -- fine for a throwaway compose stack,
# never for a real deployment (see KMS_PROVIDER note below).
JWT_SECRET_KEY=local-dev-only-jwt-secret-do-not-use-in-production
CONNECTOR_SECRET_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddee

# KMS_PROVIDER=local is refused outright when ENVIRONMENT=production
# (app/shared/config/settings.py's _reject_local_kms_in_production) -- fine
# here since ENVIRONMENT=development above.
KMS_PROVIDER=local

CORS_ALLOWED_ORIGINS=http://localhost:8080

# Required for real Q&A/investigation/postmortem generation to work against
# this stack -- without it, ingestion/search still function, but every LLM
# call fails (safely: confidence-gated decline, not a fabricated answer).
OPENAI_API_KEY=sk-replace-with-a-real-key
