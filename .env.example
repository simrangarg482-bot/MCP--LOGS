# EKIP local development environment template.
#
# Copy to `.env` (git-ignored) and fill in real values. Every field here
# maps directly to app/shared/config/settings.py's Settings class -- see
# that file for the authoritative description of each one.

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Leave noisy per-query SQL and full JSON trace spans off during ingestion.
# DATABASE_ECHO=false
# OTEL_CONSOLE_EXPORTER_ENABLED=false

# --- Database / cache (required) ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
REDIS_URL=redis://localhost:6379/0

# --- Ingestion worker reliability (optional) --------------------------------
# Hard ceiling per attempt; page checkpoints let a retry resume safely.
# INGESTION_JOB_TIMEOUT_SECONDS=7200
# Keep low on CPU/memory-constrained workers; embedding is resource intensive.
# INGESTION_WORKER_MAX_JOBS=2
# INGESTION_CHECKPOINT_TTL_SECONDS=86400
# INGESTION_MAX_PAGES_PER_ATTEMPT=10000
# INGESTION_MAX_ITEMS_PER_PAGE=2000
# INGESTION_MAX_DOCUMENT_BYTES=10000000
# INGESTION_MAX_CHUNKS_PER_DOCUMENT=1000
# EMBEDDING_WORKER_THREADS=1
# EMBEDDING_BATCH_SIZE=32

# --- AI (required) -------------------------------------------------------------
OPENAI_API_KEY=sk-your-real-key-here
# AGENT_LLM_MODEL=gpt-4o-mini

# --- Auth (required) -----------------------------------------------------------
JWT_SECRET_KEY=generate-a-long-random-string-for-this

# --- CORS ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API from a
# browser. Never a literal "*" -- rejected outright (see settings.py's
# _reject_wildcard_origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secret management (KMS) --------------------------------------------------
# "local" for development/test (never production -- settings.py refuses to
# start with ENVIRONMENT=production and KMS_PROVIDER=local). See
# docs/operations/deployment.md for the "azure" production path.
KMS_PROVIDER=local
CONNECTOR_SECRET_MASTER_KEY=generate-a-hex-encoded-32-byte-key-for-this
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# AZURE_KEY_VAULT_KEY_NAME=connector-secrets-kek

# --- Optional: real connector test credentials, for frontend/e2e's
# critical-workflow.spec.ts connector-connect-and-sync step. Skipped
# cleanly if unset.
# EKIP_TEST_GITHUB_TOKEN=
# EKIP_TEST_GITHUB_REPOS=owner/repo1,owner/repo2
