# EKIP local development environment template.
#
# Copy to `.env` (git-ignored) and fill in real values. Every field here
# maps directly to app/shared/config/settings.py's Settings class -- see
# that file for the authoritative description of each one.

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Leave noisy per-query SQL and full JSON trace spans off during ingestion.
# DATABASE_ECHO=false
# OTEL_CONSOLE_EXPORTER_ENABLED=false

# --- Database / cache (required) ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
REDIS_URL=redis://localhost:6379/0

# --- Ingestion worker reliability (optional) --------------------------------
# Hard ceiling per attempt; page checkpoints let a retry resume safely.
# INGESTION_JOB_TIMEOUT_SECONDS=7200
# Keep low on CPU/memory-constrained workers; embedding is resource intensive.
# INGESTION_WORKER_MAX_JOBS=2
# INGESTION_CHECKPOINT_TTL_SECONDS=86400
# INGESTION_MAX_PAGES_PER_ATTEMPT=10000
# INGESTION_MAX_ITEMS_PER_PAGE=2000
# INGESTION_MAX_DOCUMENT_BYTES=10000000
# INGESTION_MAX_CHUNKS_PER_DOCUMENT=1000
# EMBEDDING_WORKER_THREADS=1
# EMBEDDING_BATCH_SIZE=32

# --- AI (required) -------------------------------------------------------------
OPENAI_API_KEY=sk-your-real-key-here
# AGENT_LLM_MODEL=gpt-4o-mini

# --- Auth (required) -----------------------------------------------------------
JWT_SECRET_KEY=generate-a-long-random-string-for-this

# --- CORS ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API from a
# browser. Never a literal "*" -- rejected outright (see settings.py's
# _reject_wildcard_origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secret management (KMS) --------------------------------------------------
# "local" for development/test (never production -- settings.py refuses to
# start with ENVIRONMENT=production and KMS_PROVIDER=local). See
# docs/operations/deployment.md for the "azure" production path.
KMS_PROVIDER=local
CONNECTOR_SECRET_MASTER_KEY=generate-a-hex-encoded-32-byte-key-for-this
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# AZURE_KEY_VAULT_KEY_NAME=connector-secrets-kek

# --- Optional: real connector test credentials, for frontend/e2e's
# critical-workflow.spec.ts connector-connect-and-sync step. Skipped
# cleanly if unset.
# EKIP_TEST_GITHUB_TOKEN=
# EKIP_TEST_GITHUB_REPOS=owner/repo1,owner/repo2

# --- Email (verification mail and invitation mail) ----------------------------
# Without a provider, sign-up is unavailable and invitations fall back to a link the
# admin copies by hand. See docs/operations/invitation-email.md.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_FROM_NAME=EKIP
# The link in every email is built from this. It MUST be the publicly reachable https://
# URL of the web app before real deployment (localhost links only work on your own machine).
# FRONTEND_PUBLIC_BASE_URL=https://app.example.com
# Invitation limits (defaults shown): per organization, plus per-invitation resend bounds.
# INVITATION_MAX_PER_HOUR=20
# INVITATION_MAX_PER_DAY=100
# INVITATION_RESEND_COOLDOWN_SECONDS=60
# INVITATION_MAX_RESENDS=5

# --- Single sign-on (see docs/operations/sso-login.md) ---------------------------
# The redirect URI registered at the identity provider is <app origin>/o/<org-slug>/callback;
# the app's origin MUST appear in CORS_ALLOWED_ORIGINS above. Login transactions live in Redis.
# SSO_TRANSACTION_TTL_SECONDS=600
# SSO_HTTP_TIMEOUT_SECONDS=10
# Development/test ONLY (refused when ENVIRONMENT=production): allow an http:// or loopback
# identity provider, e.g. a local Keycloak.
# SSO_ALLOW_INSECURE_ISSUERS=false

# --- Password reset / hashing (see docs/operations/password-reset.md) -------------
# Reset links need working email (above) and a public https FRONTEND_PUBLIC_BASE_URL.
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_MAX_SENDS_PER_DAY=5
# Argon2id cost of NEW password hashes (each concurrent hash needs this much memory):
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=2

# --- Platform operator console (see docs/operations/organization-lifecycle.md) -----
# Kill switch. OFF by default; REFUSED at startup when ENVIRONMENT=production (production platform
# access stays disabled until operator MFA exists). Development/test only for now.
# PLATFORM_ADMIN_ENABLED=false
# PLATFORM_TOKEN_EXPIRY_MINUTES=15

# --- SCIM 2.0 provisioning (see docs/operations/scim-provisioning.md) ---------------
# Kill switch, OFF by default. Each organization must also enable SCIM in Settings -> Provisioning.
# SCIM_ENABLED=false
# SCIM_TOKEN_DEFAULT_TTL_DAYS=90
# SCIM_TOKEN_MAX_TTL_DAYS=365
# SCIM_REQUESTS_PER_MINUTE=300
# SCIM_MAX_ACTIVE_TOKENS=5

# --- Retention, document cleanup and storage monitoring (see docs/operations/data-retention.md) ----------
# RETENTION_ENABLED=true
# RETENTION_DRY_RUN=false
# RETENTION_HOUR=3
# RETENTION_BATCH_SIZE=1000
# INGESTION_JOB_RETENTION_DAYS=90
# REFRESH_TOKEN_EXPIRED_GRACE_DAYS=7
# REFRESH_TOKEN_REVOKED_RETENTION_DAYS=30
# EMAIL_VERIFICATION_RETENTION_DAYS=7
# PASSWORD_RESET_RETENTION_DAYS=7
# SCIM_TOKEN_RETENTION_DAYS=90
# SCIM_PENDING_ACTION_RETENTION_DAYS=180
# DOCUMENT_SOFT_DELETE_CHUNK_RETENTION_DAYS=7
# DOCUMENT_VERSION_KEEP_LATEST=5
# DOCUMENT_VERSION_RETENTION_DAYS=90
# DATABASE_STORAGE_LIMIT_BYTES=          # the limit that applies to YOUR database; never guessed
# STORAGE_WARNING_PERCENT=70
# AUDIT_ARCHIVE_DIRECTORY=
# AUDIT_ARCHIVE_MIN_AGE_DAYS=365
