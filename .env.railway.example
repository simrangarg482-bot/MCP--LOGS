# EKIP on Railway -- environment variable reference.
#
# Railway has no `.env` file: set these in each service's Variables tab (or
# in a shared Variable Group referenced by every service). `${{...}}` values
# are Railway reference variables -- paste them verbatim, Railway resolves
# them per environment. See docs/operations/deployment-railway.md for the
# full walkthrough and the dashboard steps.
#
# Six services, one repo:
#   Postgres   -- Railway Postgres plugin WITH the `vector` extension (pgvector)
#   Redis      -- Railway Redis plugin
#   backend    -- railway.backend.json          (public domain)
#   ingestion  -- railway.ingestion-worker.json (no domain)
#   agents     -- railway.agents-worker.json    (no domain)
#   mcp        -- railway.mcp.json              (public domain)
#   frontend   -- frontend/railway.json         (public domain, root dir = /frontend)


# ===========================================================================
# SHARED -- set on backend, ingestion, agents, and mcp (a Variable Group is
# the least error-prone way). The frontend needs only VITE_API_BASE_URL.
# ===========================================================================

# --- Environment ------------------------------------------------------------
# Kept at `development` on purpose: app/shared/config/settings.py's
# `_reject_local_kms_in_production` refuses to boot with
# ENVIRONMENT=production + KMS_PROVIDER=local, and this deployment uses the
# local KMS. Revisit both together if a real KMS is introduced.
ENVIRONMENT=development
LOG_LEVEL=INFO
KMS_PROVIDER=local

# --- Database (Railway Postgres over PRIVATE networking) -------------------
# This is the RUNTIME connection -- what backend/ingestion/agents/mcp
# actually query through for the entire lifetime of the deployment. It MUST
# be the ekip_app role (NOSUPERUSER/NOBYPASSRLS, provisioned by migration
# b8f3d6a1c4e7), never Railway's default Postgres superuser
# (${{Postgres.PGUSER}}) -- that role has BYPASSRLS, which makes every RLS
# policy from c7d4e8f19a2b a silent no-op (EKIP_TENANT_ISOLATION_SECURITY_
# REVIEW.md recommendation #2). `?sslmode=disable`: Railway's private
# network never leaves the project and its Postgres image serves only a
# self-signed cert, which asyncpg's default `ssl=True` (verify-full) would
# reject -- read by app/database/session.py's `_ssl_connect_arg`.
#
# EKIP_APP_PASSWORD below must be the SAME value passed as
# EKIP_APP_ROLE_PASSWORD (backend-only section further down), which is what
# migration b8f3d6a1c4e7 uses to create/converge this role's password --
# generate it once, use it in both places.
DATABASE_URL=postgresql+asyncpg://ekip_app:${{EKIP_APP_PASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}?sslmode=disable
EKIP_APP_PASSWORD=generate-a-long-random-string

# --- Redis (Railway Redis over PRIVATE networking) ------------------------
# Railway's Redis plugin already exposes REDIS_URL as the private-network
# `redis://default:...@redis.railway.internal:6379` form. Confirm it points
# at `.railway.internal` (not a `.proxy.rlwy.net` proxy host) before relying
# on it; if it doesn't, build it from ${{Redis.REDISUSER}}/${{Redis.REDISPASSWORD}}/
# ${{Redis.RAILWAY_PRIVATE_DOMAIN}} instead.
REDIS_URL=${{Redis.REDIS_URL}}

# --- AI (required) --------------------------------------------------------
OPENAI_API_KEY=sk-your-real-key-here
# AGENT_LLM_MODEL=gpt-4o-mini

# --- Auth (required) -----------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-a-long-random-string

# --- Secret management (local KMS) -------------------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"  -> 64 hex chars
CONNECTOR_SECRET_MASTER_KEY=generate-a-hex-encoded-32-byte-key

# --- CORS -- backend only, but harmless in the shared group --------------
# The frontend's public origin. Never "*" (settings.py rejects it).
CORS_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# --- Ingestion tuning (optional; defaults live in settings.py) ------------
# INGESTION_JOB_TIMEOUT_SECONDS=7200
# INGESTION_WORKER_MAX_JOBS=2
# EMBEDDING_WORKER_THREADS=1
# EMBEDDING_BATCH_SIZE=32


# ===========================================================================
# backend service ONLY -- in addition to the shared block above.
#
# `railway.backend.json`'s `preDeployCommand` (`alembic upgrade head`) runs
# in this SAME service, so it shares the shared block's `DATABASE_URL`
# (ekip_app) unless overridden here. Migrations need CREATE ROLE/ALTER
# TABLE/GRANT privileges ekip_app is deliberately never given (it is the
# role those grants exist to restrict) -- MIGRATION_DATABASE_URL points
# alembic at Railway's actual Postgres superuser instead, read by
# app/database/migrations/base.py, and does not affect the app's own
# runtime queries at all (those always use DATABASE_URL above).
#
# EKIP_APP_ROLE_PASSWORD is also backend-only: it's read once, by migration
# b8f3d6a1c4e7, at `alembic upgrade head` time, to create/converge the
# ekip_app role -- it must be the SAME value as EKIP_APP_PASSWORD above.
MIGRATION_DATABASE_URL=postgresql+asyncpg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}?sslmode=disable
EKIP_APP_ROLE_PASSWORD=generate-a-long-random-string-same-value-as-EKIP_APP_PASSWORD-above


# ===========================================================================
# mcp service ONLY -- in addition to the shared block above
# ===========================================================================

# The MCP server's own public HTTPS URL. Must match the hostname Claude
# reaches it at: it becomes the OAuth issuer/resource URL AND is folded into
# the transport-layer allowed-hosts list by scripts/run_mcp_server.py.
MCP_PUBLIC_BASE_URL=https://${{mcp.RAILWAY_PUBLIC_DOMAIN}}
# scripts/run_mcp_server.py already binds 0.0.0.0 and reads $PORT; it also
# auto-allows $RAILWAY_PUBLIC_DOMAIN. Set this only for an extra hostname
# (custom domain, tunnel):
# MCP_ALLOWED_HOSTS=mcp.example.com


# ===========================================================================
# frontend service ONLY -- this is a BUILD-time variable (Vite inlines it).
# Railway exposes every service variable as a Docker build arg automatically.
# ===========================================================================
VITE_API_BASE_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
