# Base URL of the EKIP FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# When true, the app reads from the in-memory mock data layer (src/mocks)
# instead of calling the real backend. Flip to false to use the real backend
# via email/password signup and login (POST /auth/signup, POST /auth/login).
VITE_USE_MOCK_DATA=false
