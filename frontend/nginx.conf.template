# Server block for EKIP's static frontend bundle. Rendered from this
# template at container start by the nginx image's own
# /docker-entrypoint.d/20-envsubst-on-templates.sh, which runs `envsubst`
# over every /etc/nginx/templates/*.template file into /etc/nginx/conf.d/.
#
# Only `${PORT}` is substituted -- the Dockerfile sets
# NGINX_ENVSUBST_FILTER=^PORT$ so nginx's own `$uri` / `$host` variables
# below are left untouched. `${PORT}` is whatever the platform injects
# (Railway sets it per deploy); the Dockerfile provides a default so a plain
# `docker run` still works.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: every client-side route (React Router,
    # frontend/src/routes/index.tsx) must resolve to index.html so the app's
    # own router -- not nginx -- decides what to render; only a real static
    # asset short-circuits this.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite's hashed build filenames (frontend/vite.config.ts's
    # manualChunks) are safe to cache aggressively -- a new deploy always
    # ships new hashes, never reuses an old one under the same URL.
    location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # index.html itself must never be cached this way -- it's what
    # references the current build's hashed asset filenames, so a stale
    # cached copy would point at assets that no longer exist post-deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
