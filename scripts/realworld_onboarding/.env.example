# Configuration for the real-world onboarding / SSO test harness.
# Copy this file to `.env` in this same directory and fill in real values.
# This file is entirely separate from the *project's* own `.env` (which
# configures the running server) -- this one configures the *test client*.

# --- Where the EKIP REST API is actually reachable --------------------------
BASE_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=45
# 45s default, not 15s: the API server's first request after startup often
# pays a cold-start cost establishing its own DB connection pool (same class
# of delay scripts/diagnose_db_connection.py's own docstring warns about for
# a suspended Neon compute) -- this script's own DB writes (common/bootstrap.py)
# use a separate, already-warm connection and won't show this delay, which is
# why a plain script-side timeout here can look confusing on a first run.
REQUEST_TIMEOUT_SECONDS=45    

# --- Identity Provider (required only for Script 05, a REAL browser login) -
# Fill these in with a real OIDC application registered with one of EKIP's
# already-supported providers: Microsoft Entra ID, Okta, Auth0, or Google
# Workspace. Leave blank to skip real IdP login -- every other script in
# this harness still works, using seeded sessions instead (see the README).
SSO_PROVIDER=okta  
CLIENT_ID=   
CLIENT_SECRET=     
ISSUER=     
DISCOVERY_URL=
REDIRECT_URI=http://localhost:8000/auth/callback

# --- A real IdP test user (required only for a fully automated browser login,
# via Claude in Chrome / Playwright / Selenium -- see 05_login_flow.py) -----
TEST_EMAIL=
TEST_PASSWORD=

# --- Organization this run operates against ---------------------------------
ORG_NAME=Acme Realworld Test Corp
ORG_SLUG=acme-realworld-test

# --- A second organization, used only by 08_isolation_tests.py -------------
ORG_B_NAME=Bravo Realworld Test Corp
ORG_B_SLUG=bravo-realworld-test
