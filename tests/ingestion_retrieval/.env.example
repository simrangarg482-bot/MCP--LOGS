# Configuration for the ingestion & retrieval RAG test harness.
# Copy this file to `.env` in this same directory and fill in real values.
#
# This is SEPARATE from the project's own root `.env` (which configures the
# running server -- DATABASE_URL, OPENAI_API_KEY, JWT_SECRET_KEY, etc.).
# This file only holds external-source credentials and harness-only knobs.
# `app/shared/config/settings.py` deliberately excludes connector
# credentials from the app's own Settings -- see config.py's module
# docstring.

# --- Where the EKIP REST API is actually reachable --------------------------
EKIP_BASE_URL=http://localhost:8000
EKIP_TEST_REQUEST_TIMEOUT_SECONDS=45

# --- Organization this run operates against ----------------------------------
EKIP_TEST_ORG_NAME=RAG Pipeline Test Corp
EKIP_TEST_ORG_SLUG=rag-pipeline-test
EKIP_TEST_ADMIN_EMAIL=rag-harness-admin@example.test
EKIP_TEST_ADMIN_NAME=RAG Harness Admin

# --- Slack --------------------------------------------------------------------
# Bot token needs scopes: channels:history, channels:read (or group: variants
# for private channels).
EKIP_TEST_SLACK_BOT_TOKEN=
EKIP_TEST_SLACK_CHANNEL_IDS=
# comma-separated Slack channel IDs, e.g. C0123456,C0654321

# --- GitHub ---------------------------------------------------------------------
# PAT (classic or fine-grained) needs `repo` read access to the target repo.
EKIP_TEST_GITHUB_TOKEN=
EKIP_TEST_GITHUB_REPO=
# single "owner/name", e.g. octocat/Hello-World
EKIP_TEST_GITHUB_REF=main

# --- Jira -----------------------------------------------------------------------
EKIP_TEST_JIRA_BASE_URL=
# e.g. https://acme.atlassian.net
EKIP_TEST_JIRA_EMAIL=
EKIP_TEST_JIRA_API_TOKEN=
EKIP_TEST_JIRA_PROJECTS=
# comma-separated project keys, e.g. OPS,ENG

# --- Confluence -------------------------------------------------------------------
EKIP_TEST_CONFLUENCE_BASE_URL=
# e.g. https://acme.atlassian.net
EKIP_TEST_CONFLUENCE_EMAIL=
EKIP_TEST_CONFLUENCE_API_TOKEN=
EKIP_TEST_CONFLUENCE_SPACES=
# comma-separated space keys, e.g. ENG,OPS

# --- Microsoft Teams --------------------------------------------------------------
# NOTE: this must be an ALREADY-ISSUED Microsoft Graph bearer access token.
# This harness cannot run an interactive OAuth/device-code flow to mint one
# itself -- obtain one via the Graph Explorer, `az account get-access-token
# --resource https://graph.microsoft.com`, or your own app registration's
# client-credentials flow, then paste the resulting token here. It WILL
# expire (typically ~1 hour) -- re-issue and re-paste if you get a 401.
EKIP_TEST_TEAMS_ACCESS_TOKEN=
EKIP_TEST_TEAMS_TEAM_ID=
EKIP_TEST_TEAMS_CHANNEL_IDS=
# comma-separated Teams channel IDs

# --- SharePoint --------------------------------------------------------------------
# Same already-issued Graph bearer token caveat as Teams above.
EKIP_TEST_SHAREPOINT_ACCESS_TOKEN=
EKIP_TEST_SHAREPOINT_SITE_IDS=
# comma-separated Graph site IDs

# --- Azure DevOps ---------------------------------------------------------------------
EKIP_TEST_AZURE_DEVOPS_ORG=
# e.g. acme-corp
EKIP_TEST_AZURE_DEVOPS_PAT=
EKIP_TEST_AZURE_DEVOPS_PROJECTS=
# comma-separated project names

# --- Runbooks (internal connector) -----------------------------------------------------
# No credentials needed -- reads this harness's own bootstrapped
# organization's real postmortem rows via the project's own database
# connection (DATABASE_URL, from the PROJECT's own root .env).

# --- Google Drive --------------------------------------------------------------------
# There is no Google Drive connector in this codebase -- nothing to
# configure here. See test_connectors.py's own printed output for details.
